@baseUrl = http://localhost:8080

### Login as admin (seeded operator via scripts/seed-dev.js)
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "admin@tickethub.local",
  "password": "admin-local"
}

### Login as customer (registered email)
# @name loginCustomer
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "maria@domain.com",
  "password": "secret-123"
}

### Login as seeded dev customer (scripts/seed-dev.js)
# @name loginSeedCustomer
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "customer@tickethub.local",
  "password": "customer-local"
}

### Login as seeded dev partner (scripts/seed-dev.js)
# @name loginSeedPartner
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "partner@tickethub.local",
  "password": "partner-local"
}

### Login with invalid credentials
# @name loginInvalid
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "maria@domain.com",
  "password": "wrong"
}

### Refresh session (paste refreshToken from login)
# @name refresh
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "PASTE_REFRESH_TOKEN_HERE",
  "accessToken": "PASTE_ACCESS_TOKEN_HERE"
}

### Logout (revokes the refresh token and, if sent, the access token)
# @name logout
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "PASTE_REFRESH_TOKEN_HERE",
  "accessToken": "PASTE_ACCESS_TOKEN_HERE"
}
