@baseUrl = http://localhost:8080

### Login as admin (bootstrap username)
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "admin-local"
}

### Login as customer (registered email)
# @name loginCustomer
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "maria@domain.com",
  "password": "secret-123"
}

### Login with invalid credentials
# @name loginInvalid
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "maria@domain.com",
  "password": "wrong"
}

### Refresh session (paste refreshToken from login)
# @name refresh
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "PASTE_REFRESH_TOKEN_HERE"
}

### Logout (revokes the refresh token)
# @name logout
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "PASTE_REFRESH_TOKEN_HERE"
}
