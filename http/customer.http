@baseUrl = http://localhost:8080
# Login via auth.http first, then paste the token below.
# The token must carry the ownerId claim matching the resource being managed.
@token = PASTE_JWT_HERE
@customerId = REPLACE_WITH_CUSTOMER_ID

### Create customer
# @name createCustomer
POST {{baseUrl}}/customers
Content-Type: application/json
X-Correlation-ID: customer-create-1

{
  "cpf": "52998224725",
  "name": "Maria Silva",
  "email": "maria@domain.com",
  "password": "secret-123"
}

### Get customer by id
# @name getCustomer
GET {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{token}}
Accept: application/json

### List customers
# @name listCustomers
GET {{baseUrl}}/customers?search=maria&page=0&perPage=10&sort=name&dir=asc
Authorization: Bearer {{token}}
Accept: application/json

### Change customer name
# @name changeCustomerName
PATCH {{baseUrl}}/customers/{{customerId}}/name
Authorization: Bearer {{token}}
Content-Type: application/json
X-Correlation-ID: customer-rename-1

{
  "name": "Maria Souza"
}

### Delete customer
# @name deleteCustomer
DELETE {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{token}}

### Update customer (full update)
# @name updateCustomer
PUT {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Maria Souza"
}
