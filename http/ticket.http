@baseUrl = http://localhost:8080
# Login via auth.http as partner/admin, then paste a token carrying
# ticket:validate authority and the ownerId of the show's partner.
@token = PASTE_JWT_HERE
@showId = REPLACE_WITH_SHOW_ID
@sectionId = REPLACE_WITH_SECTION_ID
@spotId = REPLACE_WITH_SPOT_ID

### Validate ticket (door check-in)
# The security guard scans the guest QR code (payload format
# showId:sectionId:spotId) and submits the three identifiers.
# @name validateTicket
POST {{baseUrl}}/shows/{{showId}}/tickets/validate
Content-Type: application/json
Authorization: Bearer {{token}}
X-Correlation-ID: ticket-validate-1

{
  "sectionId": "{{sectionId}}",
  "spotId": "{{spotId}}"
}

### List show tickets (door preload for offline validation)
# Downloads every ticket of a show so the gate keeps matching
# ticketId:code while offline. Requires ticket:validate + show access.
# @name listShowTickets
GET {{baseUrl}}/shows/{{showId}}/tickets
Accept: application/json
Authorization: Bearer {{token}}

### List show buyers (door guest list with name/CPF per ticket)
# Buyer PII for the door; never stored offline. Requires ticket:validate + show access.
# @name listShowBuyers
GET {{baseUrl}}/shows/{{showId}}/buyers
Accept: application/json
Authorization: Bearer {{token}}
