@baseUrl = http://localhost:8080
# Registration is public but creates a PENDING partner (ADR-024): login only
# works after master approval. Login as master (admin@tickethub.local) via
# auth.http for the approve/reject calls below.
@token = PASTE_ADMIN_JWT_HERE
@partnerId = REPLACE_WITH_PARTNER_ID

### Request partner registration (public, PENDING)
# @name createPartner
POST {{baseUrl}}/partners
Content-Type: application/json
X-Correlation-ID: partner-create-1

{
  "name": "Cinema Nova",
  "cnpj": "11222333000181",
  "address": {
    "street": "Rua Augusta",
    "number": "100",
    "complement": "Sala 10",
    "neighborhood": "Centro",
    "city": "São Paulo",
    "state": "SP",
    "country": "Brasil",
    "zipCode": "01305-000"
  },
  "email": "cinema@domain.com",
  "password": "secret-123"
}

### Approve partner (ADMIN only)
# @name approvePartner
POST {{baseUrl}}/partners/{{partnerId}}/approve
Authorization: Bearer {{token}}
Accept: application/json

### Reject partner (ADMIN only)
# @name rejectPartner
POST {{baseUrl}}/partners/{{partnerId}}/reject
Authorization: Bearer {{token}}
Accept: application/json

### Change partner webhook (owner or ADMIN)
# @name changePartnerWebhook
PUT {{baseUrl}}/partners/{{partnerId}}/webhook
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "webhookUrl": "https://partner.domain.com/hook",
  "webhookSecret": "s3cr3t"
}

### Get partner by id
# @name getPartner
GET {{baseUrl}}/partners/{{partnerId}}
Authorization: Bearer {{token}}
Accept: application/json

### List partners
# @name listPartners
GET {{baseUrl}}/partners?search=cinema&page=0&perPage=10&sort=name&dir=asc
Authorization: Bearer {{token}}
Accept: application/json

### Change partner name
# @name changePartnerName
PATCH {{baseUrl}}/partners/{{partnerId}}/name
Authorization: Bearer {{token}}
Content-Type: application/json
X-Correlation-ID: partner-rename-1

{
  "name": "Cinema Novo"
}

### Change partner address
# @name changePartnerAddress
PATCH {{baseUrl}}/partners/{{partnerId}}/address
Authorization: Bearer {{token}}
Content-Type: application/json
X-Correlation-ID: partner-address-1

{
  "address": {
    "street": "Avenida Paulista",
    "number": "1000",
    "complement": null,
    "neighborhood": "Bela Vista",
    "city": "São Paulo",
    "state": "SP",
    "country": "Brasil",
    "zipCode": "01310-100"
  }
}

### Delete partner
# @name deletePartner
DELETE {{baseUrl}}/partners/{{partnerId}}
Authorization: Bearer {{token}}

### Update partner (full update)
# @name updatePartner
PUT {{baseUrl}}/partners/{{partnerId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Cinema Novo",
  "address": {
    "street": "Rua B",
    "number": "2",
    "neighborhood": "Centro",
    "city": "São Paulo",
    "state": "SP",
    "country": "Brasil",
    "zipCode": "01001000"
  }
}
