<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd
                   http://www.liquibase.org/xml/ns/dbchangelog-ext https://www.liquibase.org/xml/ns/dbchangelog-ext.xsd">
    <changeSet id="003-1-create-audit-logs" author="tickethub">
        <ext:createCollection collectionName="audit_logs"/>
    </changeSet>
    <changeSet id="003-2-create-audit-logs-indexes" author="tickethub">
        <ext:createIndex collectionName="audit_logs">
            <ext:keys>{ "occurredAt": -1 }</ext:keys>
            <ext:options>{ "name": "idx_audit_logs_occurredAt" }</ext:options>
        </ext:createIndex>
        <ext:createIndex collectionName="audit_logs">
            <ext:keys>{ "correlationId": 1 }</ext:keys>
            <ext:options>{ "name": "idx_audit_logs_correlationId" }</ext:options>
        </ext:createIndex>
    </changeSet>
</databaseChangeLog>
